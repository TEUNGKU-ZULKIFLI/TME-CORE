[27.504202, "o", "\u001b[96m\u001b[1m\r\n████████╗███╗   ███╗███████╗     ██████╗ ██████╗ ██████╗ ███████╗\r\n╚══██╔══╝████╗ ████║██╔════╝    ██╔════╝██╔═══██╗██╔══██╗██╔════╝\r\n   ██║   ██╔████╔██║█████╗█████╗██║     ██║   ██║██████╔╝█████╗\r\n   ██║   ██║╚██╔╝██║██╔══╝╚════╝██║     ██║   ██║██╔══██╗██╔══╝\r\n   ██║   ██║ ╚═╝ ██║███████╗    ╚██████╗╚██████╔╝██║  ██║███████╗\r\n   ╚═╝   ╚═╝     ╚═╝╚══════╝     ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚══════╝\r"]
[27.504227, "o", "\n    \u001b[0m\r\n\u001b[93m [🛡️] Teungku Mitigation Engine - Core (TME-CORE) v1.0.0\u001b[0m\r\n\u001b[93m [🎓] Politeknik Negeri Lhokseumawe - Teknologi Rekayasa Komputer Jaringan\u001b[0m\r\n\u001b[96m=================================================================\u001b[0m\r\n\r\n\u001b[1m🔍 Menjalankan TME-CORE Doctor...\u001b[0m\r\n"]
[28.004995, "o", "  [\u001b[92m✓\u001b[0m] Python Version : 3.11 (Terdukung)\r\n  [\u001b[92m✓\u001b[0m] Environment    : File .env ditemukan\r\n  [\u001b[92m✓\u001b[0m] Data Directory : Folder penyimpanan log siap\r\n  [\u001b[92m✓\u001b[0m] Notifikasi     : Bot Telegram Terkonfigurasi\r\n\u001b[96m-----------------------------------------------------------------\u001b[0m\r\n\u001b[92m[✓] Doctor: Semua sistem dalam kondisi PRIMA!\u001b[0m\r\n\r\n"]
[29.005514, "o", "\u001b[93m[*] Mencoba koneksi ke RouterOS MikroTik...\u001b[0m\r\n"]
[29.122146, "o", "[+] SUKSES: Terhubung ke MikroTik 192.168.10.1\r\n\u001b[92m[+] TME-CORE Engine siap menahan serangan!\u001b[0m\r\n"]
[29.122648, "o", "=================================================================\r\n"]
