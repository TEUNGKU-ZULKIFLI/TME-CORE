# ===== Lab Data Policy =====
# Raw data can be sensitive/large; keep local by default.
data/raw/*
!data/raw/.gitkeep

# Allow templates and curated processed datasets to be versioned.
!data/templates/
!data/templates/*.csv
!data/processed/
!data/processed/.gitkeep
!data/processed/*.csv

